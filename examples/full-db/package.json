{
  "name": "my-elit-app",
  "version": "0.0.0",
  "dependencies": {
    "@elitjs/cli": "file:../../packages/cli",
    "@elitjs/core": "file:../../packages/core",
    "@elitjs/function-store": "file:../../packages/function-store",
    "@elitjs/dom": "file:../../packages/dom",
    "@elitjs/el": "file:../../packages/el",
    "@elitjs/router": "file:../../packages/router",
    "@elitjs/server": "file:../../packages/server",
    "@elitjs/state": "file:../../packages/state",
    "@elitjs/style": "file:../../packages/style",
    "@elitjs/test": "file:../../packages/test",
    "@types/node": "^25.0.9"
  },
  "scripts": {
    "dev": "elit dev",
    "build": "elit build",
    "build:dev": "elit build-dev",
    "preview": "elit preview",
    "build:preview": "elit build-preview",
    "wapk:pack": "npm run build:preview && elit wapk pack ./",
    "wapk:pack:dev": "npm run build:dev && elit wapk pack ./",
    "wapk:run": "elit wapk run ./elit-full-db-example.wapk",
    "wapk:run:online": "elit wapk run ./elit-full-db-example.wapk --online",
    "wapk:inspect": "elit wapk inspect ./elit-full-db-example.wapk",
    "test": "elit test",
    "test:watch": "elit test --watch",
    "test:coverage": "elit test --coverage"
  },
  "type": "module"
}
